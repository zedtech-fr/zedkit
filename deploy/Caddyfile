# Static docs site served by Caddy (automatic HTTPS via Let's Encrypt).
# The build output of apps/docs is mounted read-only at /srv/site.
# POST /api/identity/suggest is reverse-proxied to the suggest service.

www.zedkit.app {
	redir https://zedkit.app{uri} permanent
}

zedkit.app {
	root * /srv/site
	encode zstd gzip

	handle /api/identity/suggest* {
		reverse_proxy suggest:3001
	}

	handle {
		# Renamed page: "Show the zedkit logo" is now "Show your brand logo".
		redir /docs/ui/show-the-zedkit-logo /docs/ui/show-your-brand-logo permanent

		# Extensionless static export of the search index: serve it as JSON.
		@search path /api/search
		header @search Content-Type application/json

		# Content-hashed build assets never change.
		@immutable path /_next/static/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		# /docs/foo -> docs/foo.html, /docs/ -> docs/index.html. Any other file
		# (for example /r/<name>.json) is served as-is with its own content type.
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	# handle_errors is not an ordered HTTP handler: keep it at site level.
	handle_errors {
		rewrite * /404.html
		file_server
	}
}

# Dev site: same static export, no indexing, no suggest proxy.
dev.zedkit.app {
	root * /srv/site-dev
	encode zstd gzip

	header X-Robots-Tag "noindex, nofollow"

	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond <<ROBOTS
			User-agent: *
			Disallow: /
			ROBOTS
	}

	handle {
		@search path /api/search
		header @search Content-Type application/json

		@immutable path /_next/static/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		@plain not path /_next/static/*
		header @plain Cache-Control "no-cache"

		try_files {path} {path}.html {path}/index.html
		file_server
	}
}

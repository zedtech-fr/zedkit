# Static docs site served by Caddy (automatic HTTPS via Let's Encrypt).
# The build output of apps/docs is mounted read-only at /srv/site.
# /api/identity/suggest (POST), /version and /status go to Suggest. Caddy sets X-Forwarded-For from the real
# peer and drops any value a client sent, which is what the service's trusted-proxy rule relies on.

{
	# A request to this site is small. Whoever has not sent theirs in seconds is holding a connection open, and the
	# suggest service sits behind this proxy with no other protection against it.
	servers {
		timeouts {
			read_header 5s
			read_body 10s
		}
	}
}

www.zedkit.app {
	redir https://zedkit.app{uri} permanent
}

zedkit.app {
	root * /srv/site
	encode zstd gzip

	handle /api/identity/suggest* {
		request_body {
			max_size 32KB
		}
		reverse_proxy suggest:3001 {
			flush_interval -1
			transport http {
				# Above the suggest provider budget (max 180s) plus reference fetch (max 15s).
				read_timeout 240s
				write_timeout 240s
			}
		}
	}

	handle /docs/ui/design-your-identity {
		redir * /features/identity-editor permanent
	}

	handle /docs/ui/switch-the-visual-identity-with-one-attribute {
		redir * / permanent
	}

	handle {
		# Renamed page: "Show the zedkit logo" is now "Show your brand logo".
		redir /docs/ui/show-the-zedkit-logo /docs/ui/show-your-brand-logo permanent

		# Extensionless static export of the search index: serve it as JSON.
		@search path /api/search
		header @search Content-Type application/json

		# Content-hashed build assets never change.
		@immutable path /_next/static/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		# /docs/foo -> docs/foo.html, /docs/ -> docs/index.html. Any other file
		# (for example /r/<name>.json) is served as-is with its own content type.
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	# handle_errors is not an ordered HTTP handler: keep it at site level.
	handle_errors {
		rewrite * /404.html
		file_server
	}
}

# Dev site: same static export, no indexing. Its identity creator talks to its OWN suggest instance
# (suggest-dev: separate state, separate budget, off until configured), never to the production one.
# robots.txt comes from the dev build stamp (deploy.sh --dev writes it).
dev.zedkit.app {
	root * /srv/site-dev
	encode zstd gzip

	header X-Robots-Tag "noindex, nofollow"

	handle /api/identity/suggest* {
		request_body {
			max_size 32KB
		}
		reverse_proxy suggest-dev:3001 {
			flush_interval -1
			transport http {
				# Above the suggest provider budget (max 180s) plus reference fetch (max 15s).
				read_timeout 240s
				write_timeout 240s
			}
		}
	}

	handle /docs/ui/design-your-identity {
		redir * /features/identity-editor permanent
	}

	handle /docs/ui/switch-the-visual-identity-with-one-attribute {
		redir * / permanent
	}

	handle {
		@search path /api/search
		header @search Content-Type application/json

		@immutable path /_next/static/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		@plain not path /_next/static/*
		header @plain Cache-Control "no-cache"

		try_files {path} {path}.html {path}/index.html
		file_server
	}
}

{
  "name": "zedkit",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source building blocks for modern apps.",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "build": "turbo run build",
    "test": "turbo run test",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "catalog:build": "node scripts/catalog.mjs build",
    "catalog:check": "node scripts/catalog.mjs check"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}

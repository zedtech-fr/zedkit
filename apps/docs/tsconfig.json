{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "#*": ["./app/*"], "@/*": ["./*"] }
  },
  "include": ["app", "components", "ui", "content/gallery.ts", "source.config.ts", "mdx-components.tsx", "next.config.mjs", "postcss.config.mjs"]
}

{
  "name": "@zedtech/zedkit-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Public documentation site (spike).",
  "type": "module",
  "imports": {
    "#*": "./app/*"
  },
  "scripts": {
    "docs:generate": "pnpm --filter @zedtech/zedkit-seo build && node scripts/generate.mjs",
    "docs:check": "node scripts/check.mjs",
    "docs:check-seo-export": "node scripts/check-seo-export.mjs",
    "postinstall": "pnpm docs:generate && fumadocs-mdx",
    "predev": "pnpm docs:generate && pnpm -w registry:build && pnpm --filter @zedtech/zedkit-docs^... build",
    "dev": "next dev -p 3100",
    "prebuild": "pnpm docs:generate && pnpm -w registry:build && pnpm --filter @zedtech/zedkit-docs^... build",
    "build": "next build && pnpm -w registry:check",
    "start": "next start",
    "smoke": "playwright test tests/search.spec.ts tests/home.spec.ts tests/getting-started.spec.ts tests/component-page.spec.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint app components lib ui scripts source.config.ts mdx-components.tsx"
  },
  "dependencies": {
    "@zedtech/zedkit-seo": "workspace:*",
    "@zedtech/zedkit-ui": "workspace:*",
    "fumadocs-core": "catalog:",
    "fumadocs-mdx": "catalog:",
    "fumadocs-typescript": "catalog:",
    "fumadocs-ui": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  }
}

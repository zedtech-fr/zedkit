{
  "name": "@zedtech/zedkit-core",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Typed Result helpers, safe try/catch wrappers, and prefixed IDs for any JS/TS project — stop writing the same utilities in every repo. Original work by the same author.",
  "keywords": [
    "typescript",
    "utilities",
    "result-type",
    "error-handling",
    "typed-errors",
    "ulid",
    "unique-id",
    "prefixed-id",
    "functional",
    "try-catch"
  ],
  "homepage": "https://github.com/zedtech-fr/zedkit/tree/main/packages/core",
  "bugs": {
    "url": "https://github.com/zedtech-fr/zedkit/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zedtech-fr/zedkit",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#*": "./src/*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "ulid": "catalog:"
  },
  "devDependencies": {
    "@zedtech/zedkit-quality": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

{
  "name": "@zedtech/zedkit-flags",
  "version": "0.2.2",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Typed flag registry, server evaluation, React hooks, JSON/env providers, and local override storage for dev. Original work by the same author.",
  "keywords": [
    "feature-flags",
    "openfeature",
    "react",
    "typescript",
    "server"
  ],
  "homepage": "https://github.com/zedtech-fr/zedkit/tree/main/packages/flags",
  "bugs": {
    "url": "https://github.com/zedtech-fr/zedkit/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zedtech-fr/zedkit",
    "directory": "packages/flags"
  },
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#*": "./src/*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint src tests"
  },
  "peerDependencies": {
    "@openfeature/react-sdk": "catalog:",
    "@openfeature/server-sdk": "catalog:",
    "@openfeature/web-sdk": "catalog:",
    "react": "catalog:"
  },
  "peerDependenciesMeta": {
    "@openfeature/react-sdk": {
      "optional": true
    },
    "@openfeature/web-sdk": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@zedtech/zedkit-core": "workspace:*"
  },
  "devDependencies": {
    "@openfeature/react-sdk": "catalog:",
    "@openfeature/server-sdk": "catalog:",
    "@openfeature/web-sdk": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@zedtech/zedkit-quality": "workspace:*",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}

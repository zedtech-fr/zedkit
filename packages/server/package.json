{
  "name": "@zedtech/zedkit-server",
  "version": "0.3.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Harden any Node server in minutes: boot-time env parsing, rate limiting, secret/PII redaction, HKDF crypto and HTTP helpers. Original work by the same author.",
  "keywords": [
    "nodejs",
    "server",
    "environment",
    "zod",
    "rate-limit",
    "rate-limiting",
    "redaction",
    "pii",
    "secrets",
    "logging",
    "hkdf",
    "crypto",
    "http"
  ],
  "homepage": "https://github.com/zedtech-fr/zedkit/tree/main/packages/server",
  "bugs": {
    "url": "https://github.com/zedtech-fr/zedkit/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zedtech-fr/zedkit",
    "directory": "packages/server"
  },
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#*": "./src/*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "zod": "catalog:"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint src tests"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@zedtech/zedkit-quality": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

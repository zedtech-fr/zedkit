{
  "name": "@zedtech/zedkit-seo",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Ship sitemaps, robots, typed JSON-LD, metadata, hreflang, slugs and llms.txt without thinking about the specs.",
  "keywords": [
    "seo",
    "sitemap",
    "robots-txt",
    "json-ld",
    "structured-data",
    "metadata",
    "open-graph",
    "hreflang",
    "llms-txt",
    "slug",
    "nextjs",
    "typescript"
  ],
  "homepage": "https://github.com/zedtech-fr/zedkit/tree/main/packages/seo",
  "bugs": {
    "url": "https://github.com/zedtech-fr/zedkit/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zedtech-fr/zedkit",
    "directory": "packages/seo"
  },
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#*": "./src/*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "schema-dts": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

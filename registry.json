{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "zedkit",
  "homepage": "https://github.com/zedtech-fr/zedkit",
  "items": [
    {
      "name": "badge",
      "type": "registry:ui",
      "dependencies": ["class-variance-authority", "@radix-ui/react-slot"],
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "registry/generated/ui/badge.tsx",
          "type": "registry:ui"
        }
      ],
      "cssVars": {
        "theme": {
          "ring-width": "2px",
          "ring-offset-width": "2px",
          "spacing-badge-inline": "calc(0.625rem * var(--zk-density, 1))",
          "spacing-badge-block": "calc(0.125rem * var(--zk-density, 1))"
        }
      },
      "css": {
        "@utility focus-ring": {
          "&:focus-visible": {
            "outline": "none",
            "box-shadow": "0 0 0 var(--ring-offset-width) hsl(var(--background)), 0 0 0 calc(var(--ring-offset-width) + var(--ring-width)) hsl(var(--ring))"
          }
        }
      }
    },
    {
      "name": "drawer",
      "type": "registry:ui",
      "dependencies": ["vaul"],
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "registry/generated/ui/drawer.tsx",
          "type": "registry:ui"
        }
      ],
      "cssVars": {
        "light": {
          "overlay": "0 0% 0%"
        },
        "dark": {
          "overlay": "0 0% 0%"
        }
      }
    },
    {
      "name": "confirm-dialog",
      "type": "registry:ui",
      "registryDependencies": ["button", "dialog", "utils"],
      "files": [
        {
          "path": "registry/generated/ui/confirm-dialog.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "status-dot",
      "type": "registry:ui",
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "registry/generated/ui/status-dot.tsx",
          "type": "registry:ui"
        }
      ],
      "cssVars": {
        "theme": {
          "spacing-status-dot": "0.5rem"
        }
      }
    },
    {
      "name": "checkmark",
      "type": "registry:ui",
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "registry/generated/ui/checkmark.tsx",
          "type": "registry:ui"
        }
      ],
      "cssVars": {
        "theme": {
          "spacing-checkmark": "1rem",
          "animate-check-draw": "zk-check-draw 0.45s ease-out forwards"
        }
      }
    },
    {
      "name": "updated-ago",
      "type": "registry:ui",
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "registry/generated/ui/updated-ago.tsx",
          "type": "registry:ui"
        }
      ]
    }
  ]
}

{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "zedkit",
  "homepage": "https://github.com/zedtech-fr/zedkit",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "cssVars": {
        "light": {
          "success": "142.1 76.2% 27%",
          "warning": "32 95% 44%",
          "overlay": "0 0% 0%"
        },
        "dark": {
          "success": "142.1 70.6% 45.3%",
          "warning": "32 95% 32%",
          "overlay": "0 0% 0%"
        },
        "theme": {
          "motion-fast": "150ms",
          "motion-base": "200ms",
          "motion-slow": "250ms",
          "ease-enter": "cubic-bezier(0.16, 1, 0.3, 1)",
          "ease-exit": "cubic-bezier(0.4, 0, 1, 1)",
          "zk-press-scale": "0.97"
        }
      },
      "css": {
        "@keyframes zk-fade-in": {
          "from": {
            "opacity": "0"
          }
        },
        "@keyframes zk-fade-out": {
          "to": {
            "opacity": "0"
          }
        },
        "@keyframes zk-zoom-in": {
          "from": {
            "opacity": "0",
            "transform": "scale(0.96)"
          }
        },
        "@keyframes zk-zoom-out": {
          "to": {
            "opacity": "0",
            "transform": "scale(0.96)"
          }
        },
        "@utility dialog-center": {
          "top": "var(--spacing-dialog-center)",
          "left": "var(--spacing-dialog-center)",
          "translate": "calc(var(--spacing-dialog-center) * -1) calc(var(--spacing-dialog-center) * -1)"
        },
        "@utility button-press": {
          "transition-property": "background-color, border-color, color, fill, stroke, box-shadow, translate, scale",
          "transition-duration": "var(--motion-base)",
          "transition-timing-function": "var(--zk-btn-ease, ease)",
          "&:active:not(:disabled)": {
            "scale": "var(--zk-press-scale)"
          }
        },
        "@utility focus-ring-control": {
          "&:focus-visible": {
            "outline": "none",
            "box-shadow": "0 0 0 var(--ring-offset-width) hsl(var(--background)),\n      0 0 0 calc(var(--ring-offset-width) + var(--ring-width-control)) hsl(var(--ring))"
          }
        },
        "html [data-vaul-drawer]": {
          "animation-duration": "var(--motion-slow)",
          "transition-duration": "var(--motion-slow)"
        },
        "html [data-vaul-overlay]": {
          "animation-duration": "var(--motion-base)"
        },
        "@media (prefers-reduced-motion: reduce)": {
          "html [data-vaul-drawer], html [data-vaul-overlay]": {
            "animation": "none !important",
            "transition": "none !important"
          }
        }
      }
    },
